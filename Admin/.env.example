# Must match the API base used by Client/.env (default backend port is 8001).
VITE_API_URL=http://localhost:8001/api/v1

# Comma-separated reveal-gate key sequence for the admin login screen.
# This is a UI convenience only - it grants no access, since the server still
# authenticates and authorises every request.
VITE_ADMIN_SECRET_KEY=k,r,o,m
