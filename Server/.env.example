# ---------- Core ----------
NODE_ENV=development
# Server/.env must use 8001 to match Client and Admin VITE_API_URL.
PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/kromdetail

# ---------- JWT ----------
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRES=7d
JWT_AUDIENCE=kromdetail-api
JWT_ISSUER=kromdetail

# ---------- Field encryption ----------
# Declared in src/config/env.js but not yet consumed by any module. Reserved for
# encrypting Notification payloads at rest; setting them has no effect today.
CRYPTO_SECRET=replace_with_a_long_random_string
CRYPTO_ALGORITHM=aes-256-gcm
CRYPTO_IV=replace_16_char_iv

# ---------- Auth / OTP ----------
BCRYPT_SALT_ROUNDS=10
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# ---------- Frontend origins ----------
# Origins allowed by CORS, comma separated. No trailing slash, no path.
# Localhost for development. On going live, append the frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Cloudinary (media uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- SMTP (email) ----------
# Email delivery is best effort for logins, so a wrong host here degrades email
# without taking the API down. The OTP mail is the one exception: it fails with
# a 503 because the user has no other way to receive the code.
# Provider presets:
#   Gmail    SMTP_HOST=smtp.gmail.com    SMTP_PORT=465 SMTP_SECURE=true  (App Password required)
#   Brevo    SMTP_HOST=smtp.brevo.com    SMTP_PORT=587 SMTP_SECURE=false (300 emails/day free)
#   Resend   SMTP_HOST=smtp.resend.com   SMTP_PORT=465 SMTP_SECURE=true
# SMTP_SECURE defaults to true on port 465 and false otherwise.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---------- Logging ----------
# Node log levels: error, warn, info, http, verbose, debug.
# Logs always go to stdout (Render reads it) and to Server/logs/*.log.
LOG_LEVEL=info

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
# Generous ceiling for normal dashboard use; only stops runaway traffic.
RATE_LIMIT_MAX_REQUESTS=300
# Only failed logins count towards the login limit.
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX_ATTEMPTS=10
REGISTER_LIMIT_WINDOW_MS=3600000
REGISTER_LIMIT_MAX_ATTEMPTS=20
PASSWORD_RESET_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_LIMIT_MAX_ATTEMPTS=5

# ---------- Razorpay ----------
# Leave empty to run without online payments. When empty, POST /api/v1/payments/order
# returns 503 and the customer checkout is unavailable; offline payments still work.
# The public key id is also needed by the Client app as VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay dashboard > Settings > Webhooks.
# POST /api/v1/payments/webhooks/razorpay returns 503 while this is empty.
RAZORPAY_WEBHOOK_SECRET=
