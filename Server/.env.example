# ---------- Core ----------
NODE_ENV=development
# Server/.env must use 8001 to match Client and Admin VITE_API_URL.
PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/kromdetail

# ---------- JWT ----------
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRES=7d
JWT_AUDIENCE=kromdetail-api
JWT_ISSUER=kromdetail

# ---------- Field encryption ----------
# Declared in src/config/env.js but not yet consumed by any module. Reserved for
# encrypting Notification payloads at rest; setting them has no effect today.
CRYPTO_SECRET=replace_with_a_long_random_string
CRYPTO_ALGORITHM=aes-256-gcm
CRYPTO_IV=replace_16_char_iv

# ---------- Auth / OTP ----------
BCRYPT_SALT_ROUNDS=10
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# ---------- Frontend origins ----------
CLIENT_URL=http://localhost:5173

# ---------- Cloudinary (media uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- SMTP (email) ----------
SMTP_USER=
SMTP_PASS=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Razorpay ----------
# Leave empty to run without online payments. When empty, POST /api/v1/payments/order
# returns 503 and the customer checkout is unavailable; offline payments still work.
# The public key id is also needed by the Client app as VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay dashboard > Settings > Webhooks.
# POST /api/v1/payments/webhooks/razorpay returns 503 while this is empty.
RAZORPAY_WEBHOOK_SECRET=
