# Must match the API base used by Admin/.env (default backend port is 8001).
VITE_API_URL=http://localhost:8001/api/v1

# Razorpay PUBLIC key id (rzp_live_... / rzp_test_...).
# Never put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET here - anything in a
# VITE_ variable is bundled into the browser build and is public.
# Leave empty to disable the customer checkout button; invoices and offline
# payments remain usable.
VITE_RAZORPAY_KEY_ID=
